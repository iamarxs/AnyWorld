# Copy to docker.env. Do not commit that file or print resolved Compose secrets.
# Local llama.cpp with NVIDIA GPU acceleration (requires an NVIDIA GPU).
# The separator is explicit so Windows/Linux use the same syntax.
COMPOSE_PATH_SEPARATOR=|
COMPOSE_FILE=compose.yaml|compose.llama.yaml
# Set to tunnel for a public HTTPS link; leave empty for direct access only.
COMPOSE_PROFILES=
# For debug append |compose.debug.yaml.
# For the remote OpenAI API (no local GPU), use compose.yaml|compose.openai.yaml.
# OpenAI selection starts no llama container and does not require HF_REPO/HF_FILE.
# Suggested: "gpt-5.6-luna" - fast, cheap, smart
OPENAI_MODEL=
# Your OpenAI API token, only needed when using 'compose.yaml|compose.openai.yaml' (OpenAI backend).
AD_OPENAI_API_KEY=
# Local only: explicitly select a repository and exact file; no model is selected here.
HF_REPO=
HF_FILE=
# Recommended for 16 GB VRAM (14.3 GB weights; context/KV cache also need memory):
# HF_REPO=EZForever/gemma-4-26B-A4B-it-qat-uncensored-heretic-UDmerge-GGUF
# HF_FILE=gemma-4-26B-A4B-it-qat-uncensored-heretic-UDmerge-Q4_K_XXL.gguf
# MODEL_ALIAS=EZForever/gemma-4-26B-A4B-it-qat-uncensored-heretic-UDmerge-GGUFQ4_K_XXL
MODEL_ALIAS=local
HF_TOKEN=
# Set a distinct host password for the game
AD_SERVER__HOST_PASSWORD=
# Set a distinct player password for the game
AD_SERVER__PLAYER_PASSWORD=
GAME_CONFIG=./docker/game.example.yaml
GAME_BIND_ADDRESS=0.0.0.0
GAME_PORT=4141
# JSON list: retain game and localhost for the tunnel and health check.
# Add the actual LAN/public/VPN IPs or hostnames used for direct connections.
TLS_ADDRESSES='["game","localhost","127.0.0.1"]'
MODEL_STARTUP_TIMEOUT=3600s
# Included canonical template, mounted read-only from the project.
CHAT_TEMPLATE_FILE=./docker/templates/google-gemma-4-canonical-templ.jinja
# No forced no-thinking modification is applied to the template.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Change all three together if this IPv4 subnet conflicts with LAN/VPN/Docker.
TUNNEL_SUBNET=172.30.41.0/24
TUNNEL_IP=172.30.41.2
GAME_INGRESS_IP=172.30.41.3
